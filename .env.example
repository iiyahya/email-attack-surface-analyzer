# Email Attack Surface Analyzer Configuration

# Optional: VirusTotal API Key for subdomain discovery
# Get your API key from: https://www.virustotal.com/gui/user/[username]/apikey
VIRUSTOTAL_API_KEY=

# Optional: Path to Sublist3r installation
# Leave empty if Sublist3r is not installed
SUBLISTER_PATH=

# Optional: Path to Amass binary
# Default: amass (assumes it's in PATH)
AMASS_PATH=amass

# Optional: Path to Subfinder binary
# Default: subfinder (assumes it's in PATH)
SUBFINDER_PATH=subfinder

# DNS Query Settings
DNS_TIMEOUT=5
DNS_RETRIES=2

# Common DKIM Selectors to Check (comma-separated)
DKIM_SELECTORS=default,google,k1,k2,k3,selector1,selector2,dkim,mail,email,mx
